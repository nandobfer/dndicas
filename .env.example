# ─────────────────────────────────────────────────────────────────────────────
# Variáveis de bootstrap do DnDicas.
#
# Só ficam aqui as variáveis necessárias para o app subir e conectar no banco. Todas as
# demais integrações (Google, Pusher, Storage S3, SMTP, Crons, Provedores de IA, Analytics e
# Tradução) são configuradas pelos administradores em /integracoes e gravadas no MongoDB.
#
# Migração: na primeira subida, os valores antigos ainda presentes no .env (S3_*, PUSHER_*,
# SMTP_*, GOOGLE_CLIENT_*, GOOGLE_API_KEY, CRON_SECRET, LIBRETRANSLATE_*...) são copiados
# uma única vez para o banco. Depois disso, a tela de Integrações é a fonte de verdade.
# ─────────────────────────────────────────────────────────────────────────────

# App
NEXT_PUBLIC_APP_URL=
AUTH_URL=

# Auth.js (sessão) — gere com: openssl rand -base64 32
AUTH_SECRET=

# MongoDB
MONGODB_URI=mongodb://<user>:<password>@<host>:27017/dndicas?authSource=admin

# Chave AES-256-GCM dos segredos das integrações — gere com: openssl rand -base64 32
# Sem ela, os segredos não são gravados no banco (um aviso aparece no log).
INTEGRATIONS_ENCRYPTION_KEY=
